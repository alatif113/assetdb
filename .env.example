# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Splunk dev server (private test box, never production) ---
SPLUNK_HOST=splunk.home
SPLUNK_MGMT_PORT=8089
SPLUNK_WEB_PORT=8000
# Comma-separated hosts deploy/integration scripts may touch. Anything else is refused.
ALLOWED_HOSTS=splunk.home

# --- Auth: token preferred, user/password as fallback ---
SPLUNK_TOKEN=
SPLUNK_USER=
SPLUNK_PASSWORD=

# --- TLS ---
# Path to a CA bundle that signs the server certificate (self-signed cert: export it here).
SPLUNK_CA_BUNDLE=
# Explicit opt-in to skip certificate verification. Prints a warning every time. Default off.
SPLUNK_INSECURE_TLS=0

# --- SSH deploy ---
SSH_TARGET=user@splunk.home
SPLUNK_HOME_REMOTE=/opt/splunk

# --- AppInspect ---
APPINSPECT_TAGS=cloud
