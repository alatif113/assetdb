
# Application-level permissions

[]
access = read : [ * ], write : [ admin ]

### CONFIGURATION: only admins change the merge configuration, the scheduled search that runs the
### generated SPL, and the data model. Read access follows the app default; adjust in local.meta
### (or in Splunk Web under Permissions) to restrict who can read the merged assets.

[assetdb]
access = read : [ * ], write : [ admin ]

[savedsearches/assetdb-lookupgen]
access = read : [ * ], write : [ admin ]

[collections/assetdb]
access = read : [ * ], write : [ admin ]

[transforms/assetdb]
access = read : [ * ], write : [ admin ]

[collections/assetdb_runs]
access = read : [ * ], write : [ admin ]

[collections/assetdb_overflow]
access = read : [ * ], write : [ admin ]

[transforms/assetdb_overflow]
access = read : [ * ], write : [ admin ]

[transforms/assetdb_runs]
access = read : [ * ], write : [ admin ]

[savedsearches/assetdb-run-alert]
access = read : [ * ], write : [ admin ]

### VISUALIZATIONS: used by this app's own dashboard only, so they are not exported to other apps.

[visualizations/adb_heatmap]
access = read : [ * ], write : [ admin ]

[visualizations/adb_asset_explorer]
access = read : [ * ], write : [ admin ]


### TRANSFORMS

[transforms]
export = system


### LOOKUPS

[lookups]
export = system


### MACROS: the enrichment macros are meant to be used from other apps

[macros]
export = system
